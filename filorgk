#!/usr/bin/env bash
# shellcheck source=/dev/null
# shellcheck disable=2155
# A light wieght multipurpose file organiser built in bash
# 
#

set -euo pipefail

readonly VERSION=0.0.1
readonly PROG_NAME=$(basename "$0")


export DATE="$(date +%Y_%m_%d)"
export SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)

export LOGS_DIR=${LOGS_DIR:-"$HOME/.local/state/$PROG_NAME/logs"}
export BACKUP_DIR=${BACKUP_DIR:-"$HOME/.local/share/$PROG_NAME/backup"}

export core_dir="$SCRIPT_DIR/lib/core"
export function_dir="$SCRIPT_DIR/lib/functions"

export current_err_log_path="$LOGS_DIR/err_$DATE.log"
export current_info_log_path="$LOGS_DIR/info_$DATE.log"
export run_count_path="$LOGS_DIR/run_count.log"



# source core scripts
for script in "$core_dir"/*; do
    source "$script"
done

increment_run_count() {
    local run_count
    if [[ ! -f "$run_count_path" ]]; then
        echo 0 > "$run_count_path"
    fi
    run_count=$(<"$run_count_path")
    run_count=$((run_count + 1))
    echo "$run_count" > "$run_count_path"
}

run_count=$(cat "$run_count_path")
export found_files_store_path="$LOGS_DIR/found_files_$run_count.log"

main() {
    local option
    create_dir "$LOGS_DIR" "$BACKUP_DIR" || {
        echo "Failed to create logs or backup directory" >&2
        error "Failed to create logs or backup directory"
        exit 1
    }
    increment_run_count || {
        echo "Failed to increment run count" >&2
        error "Failed to increment run count"
        exit 1
    }
    printf "Enter the directory to organise: "
    find_files || {
        echo "Failed to find files" >&2
        error "Failed to find files"
        exit 1
    }
    display_found_files || {
        echo "Failed to display found files" >&2
        error "Failed to display found files"
        exit 1
    }

    option=$(get_sub_option "$(get_main_option)") || {
        echo "Failed to get sub option" >&2
        error "Failed to get sub option"
        exit 1
    }

    execute_sub_option "$option" || {
        echo "Failed to execute sub option: $option" >&2
        error "Failed to execute sub option: $option"
        exit 1
    }

    printf "Operation completed successfully\n"

    return 0
}
main